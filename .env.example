# =====================================================================================================
# AtlasPad - environment variable catalog
# =====================================================================================================
# Nothing loads this file. Copy each section into the place where that component reads its settings:
#
#   Web (apps/web, Next.js)   Next.js loads apps/web/.env, .env.local, .env.development[.local] and
#                             .env.production[.local] from apps/web. It does NOT read the repo-root .env.
#                             NEXT_PUBLIC_* values are inlined into the browser bundle at `next build`
#                             time: change them, then rebuild.
#   Indexer (apps/indexer)    `pnpm dev:indexer` runs `tsx watch --env-file-if-exists=.env.local
#                             --env-file-if-exists=../../.env`, so it loads apps/indexer/.env.local and
#                             then the repo-root .env. The root .env is loaded LAST, so its values override
#                             .env.local. Variables already set in the shell override both files.
#                             `pnpm --filter @atlaspad/indexer rebuild-game` and `... migrate` load the
#                             same two files. `pnpm --filter @atlaspad/indexer start` (node dist/main.js)
#                             and `node dist/migrate-cli.js` load no file, so production needs real
#                             process environment variables. (--env-file-if-exists needs Node >= 22.9,
#                             the repo minimum.)
#   DB migrations             `pnpm db:migrate` loads no file. Export DATABASE_URL in the shell.
#   Contracts (forge)         forge scripts read the shell environment. Foundry also auto-loads
#                             contracts/.env (the Foundry project root). It does not load the repo-root .env.
#
# Some names (DATABASE_URL, DATABASE_SSL, INDEXER_ADMIN_TOKEN, ATLAS_RPC_URL) appear in more than one
# section on purpose. Each section stands alone so you can copy it into the file that component reads.
#
# Empty values: the web app and the indexer treat an empty value as unset, so an empty web or indexer
# variable below falls back to its documented default. Elsewhere, set a real value or leave these out:
#   SMOKE_NAME / SMOKE_SYMBOL (empty = an empty string, and the founding transaction reverts)
#   Local tooling read with `??` (LOCAL_RPC_URL, TEST_DATABASE_URL, CHROMIUM_PATH) uses an empty value as is.
#   The Deploy.s.sol variables in section 4 are required; empty ones make forge fail.
#
# Never commit real values. .gitignore ignores .env and .env.* everywhere except this file.
# Deployment addresses stay empty here. After deploying, copy them from contracts/deployments/4663.json
# (see DEPLOYMENT.md).
# =====================================================================================================


# -----------------------------------------------------------------------------------------------------
# 1. Web - public (NEXT_PUBLIC_*): shipped to every browser, so never put secrets here.
#    Copy into apps/web/.env.local (dev) or set in the build environment (prod). Inlined at build time.
# -----------------------------------------------------------------------------------------------------

# Network key: "robinhood" (Robinhood Chain mainnet, chain 4663) or "local" (anvil, chain 31337).
# Optional, defaults to "robinhood" when unset or empty. Any other value is a config error.
NEXT_PUBLIC_ATLAS_NETWORK=robinhood

# JSON-RPC URL the browser wallet client (wagmi) uses. Optional. When empty it uses the chain default
# (https://rpc.mainnet.chain.robinhood.com for robinhood, http://127.0.0.1:8545 for local).
# This is public, so never use a URL that embeds a private API key.
NEXT_PUBLIC_RPC_URL=

# AtlasPad contract addresses. Set all three or none. With none, the app treats contracts as not deployed
# and disables founding, trading and governance. Setting only one or two is a configuration error: the app
# shows a "Configuration error" banner and disables every on-chain action. Leave all three empty until
# deployed, then copy .launchpad / .governor / .treasury from contracts/deployments/4663.json.
NEXT_PUBLIC_ATLAS_LAUNCHPAD=
NEXT_PUBLIC_ATLAS_GOVERNOR=
NEXT_PUBLIC_ATLAS_TREASURY=

# Deployment block. Optional, default 0. Digits only: any other value is a config error. The web app
# does not otherwise use it. Keep it in sync with ATLAS_DEPLOY_BLOCK.
NEXT_PUBLIC_ATLAS_DEPLOY_BLOCK=

# Uniswap V2 factory / router, WETH and $WIF. LOCAL NETWORK ONLY: required when NEXT_PUBLIC_ATLAS_NETWORK=local
# (scripts/dev-local.sh fills them in), and IGNORED for robinhood. On robinhood the app always uses the
# canonical addresses in packages/shared/src/chains.ts (ROBINHOOD_DEX, including WIF_ADDRESS).
NEXT_PUBLIC_ATLAS_UNISWAP_V2_FACTORY=
NEXT_PUBLIC_ATLAS_UNISWAP_V2_ROUTER=
NEXT_PUBLIC_ATLAS_WETH=
NEXT_PUBLIC_ATLAS_WIF=

# Where "Get $WIF" buttons send people. Optional. Default: the Uniswap app with $WIF preselected as the
# output token (https://app.uniswap.org/swap?outputCurrency=<WIF_ADDRESS>).
NEXT_PUBLIC_GET_WIF_URL=

# WalletConnect Cloud project id. Optional, default empty. When empty the WalletConnect connector is
# omitted, and injected (EIP-6963) wallets and Coinbase Wallet still work.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Public base URL of the indexer's HTTP server, which browsers must be able to reach. Example:
# https://indexer.example.com. The browser opens EventSource(<url>/stream), and a trailing slash is
# stripped. Optional, default empty: realtime is then disabled and the UI polls instead ("Polling").
NEXT_PUBLIC_REALTIME_URL=

# Canonical site URL, used for metadataBase (Open Graph URLs) and for WalletConnect/Coinbase wallet
# metadata. Must be an absolute URL, for example https://your-domain.example (a trailing slash is
# stripped). Optional: when unset or empty it defaults to http://localhost:3000, so set it to your public
# origin in production.
NEXT_PUBLIC_SITE_URL=


# -----------------------------------------------------------------------------------------------------
# 2. Web - server only: read at runtime by Next.js route handlers and proxy.ts. Never NEXT_PUBLIC_.
# -----------------------------------------------------------------------------------------------------

# PostgreSQL connection string for the indexer's database. The web app only reads from it.
# SECRET. Optional: without it every /api/* data route answers 503 {"error":"data_unavailable"} and the
# UI shows "Live world data is unavailable". Format: postgresql://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=

# Set to exactly "true" to connect with TLS (ssl: "require"). Any other value = no TLS option.
# Optional, default off.
DATABASE_SSL=false

# Max connections in the web server's postgres.js pool, per server instance. Optional, default 3 (also
# when empty). Must be a positive integer: any other value throws when the pool is created, so database
# requests fail.
DATABASE_POOL_MAX=3

# HTTP Basic credentials for /admin, /admin/* and /api/admin/*. Optional. The admin area answers 404
# unless BOTH are set AND ADMIN_PASSWORD is at least 12 characters. A shorter password logs a warning
# once and keeps the admin area disabled. ADMIN_PASSWORD is a SECRET.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Base URL of the indexer HTTP server as seen from the web SERVER (it can be a private network URL).
# Used only by /api/admin/status, which calls <INDEXER_URL>/admin/status. Optional. Without it the admin
# page shows "INDEXER_URL not configured".
INDEXER_URL=

# Bearer token the web server sends to <INDEXER_URL>/admin/status. Must equal the indexer's
# INDEXER_ADMIN_TOKEN. SECRET. Optional, default empty (the indexer then rejects the call).
INDEXER_ADMIN_TOKEN=

# Server-side RPC override used only by /api/admin/status (block head and chain-id check).
# Optional. When empty it falls back to NEXT_PUBLIC_RPC_URL, then to the chain default.
ATLAS_RPC_URL=


# -----------------------------------------------------------------------------------------------------
# 3. Indexer (apps/indexer): apps/indexer/.env.local or root .env in dev; process env in production.
# -----------------------------------------------------------------------------------------------------

# Network key: "robinhood" or "local". Optional, defaults to "robinhood" when unset or empty. Any other
# value is a startup error.
ATLAS_NETWORK=robinhood

# JSON-RPC URL used for indexing. Optional, defaults to https://rpc.mainnet.chain.robinhood.com (robinhood)
# or http://127.0.0.1:8545 (local). A dedicated provider URL is recommended in production. Treat a URL
# with an embedded API key as a SECRET. The indexer refuses to run if the RPC chain id does not match
# the network.
ATLAS_RPC_URL=

# AtlasPad contract addresses. Set all three or none. With none, the indexer logs a warning and serves
# only /health, /stream and /admin/status (it does not index). Setting only one or two is a configuration
# error and the indexer exits at startup. Leave all three empty until deployed, then copy them from
# contracts/deployments/4663.json.
ATLAS_LAUNCHPAD=
ATLAS_GOVERNOR=
ATLAS_TREASURY=

# First block to index (decimal, digits only; anything else is a startup error). Optional, default 0,
# which means scan from genesis. Set it before the FIRST start against a fresh database: indexing begins
# at ATLAS_DEPLOY_BLOCK - 1, and later changes do not move the stored cursor. See DEPLOYMENT.md for how to
# pick the value.
ATLAS_DEPLOY_BLOCK=

# Uniswap V2 factory / router, WETH and $WIF. LOCAL NETWORK ONLY: required when ATLAS_NETWORK=local and
# IGNORED for robinhood, which uses ROBINHOOD_DEX in packages/shared/src/chains.ts.
ATLAS_UNISWAP_V2_FACTORY=
ATLAS_UNISWAP_V2_ROUTER=
ATLAS_WETH=
ATLAS_WIF=

# PostgreSQL connection string. REQUIRED: the indexer exits with "DATABASE_URL is required". SECRET.
DATABASE_URL=

# Set to exactly "true" for TLS (ssl: "require"). Optional, default off.
DATABASE_SSL=false

# HTTP port for /health, /stream (SSE) and /admin/status. PORT takes precedence over INDEXER_PORT.
# Optional, default 4100. Must be an integer >= 0. PORT is left commented out because many hosts and
# `next start` also read PORT.
# PORT=
INDEXER_PORT=4100

# Blocks to stay behind the chain head. Optional, default 2. Integer >= 0. (dev-local uses 0.)
INDEXER_CONFIRMATIONS=2

# Max block range per eth_getLogs batch. Optional, default 2000. Integer >= 1. It halves automatically,
# down to 10, when the RPC rejects a range.
INDEXER_BATCH_BLOCKS=2000

# Poll interval in ms when caught up. Optional, default 2000. Integer >= 250. On errors it backs off,
# doubling up to 60000.
INDEXER_POLL_MS=2000

# Bearer token for GET /admin/status (read-only). SECRET. Optional: when empty, /admin/status answers 404.
# Generate one with: openssl rand -hex 32
INDEXER_ADMIN_TOKEN=

# Value sent verbatim as Access-Control-Allow-Origin on every response, including the SSE stream.
# It is a single origin (for example https://your-domain.example) or "*". Optional, default "*" when empty.
INDEXER_CORS_ORIGIN=

# Apply Drizzle migrations on startup. Only the exact value "false" disables this. Optional, default on.
INDEXER_RUN_MIGRATIONS=true

# Override for the Drizzle migrations folder, which must contain meta/_journal.json. Optional. When
# empty the indexer searches <module dir>/drizzle (dist/drizzle in builds) and packages/db/drizzle.
MIGRATIONS_DIR=

# $WIF/USD reference price: "dexscreener" (polls api.dexscreener.com every 60 s and uses the most liquid
# $WIF pool) or "none". Used to display USD values, recorded in hourly snapshots, and needed for the
# MCAP_1M_USD ("Millionaire Economy") achievement, which never unlocks with "none". Optional, defaults to "none" when unset or empty. Any
# other value is a startup error.
WIF_USD_SOURCE=none

# Extra addresses that are never counted as citizens. Comma-separated "address[:label]" entries, for
# example 0xabc...:Team multisig. Labels default to "Excluded". An invalid address is a startup error.
# Optional, default empty.
EXCLUDED_ADDRESSES=

# Log threshold: debug | info | warn | error. Optional, default info (unknown values fall back to info).
# Output is JSON lines, with warn and error going to stderr.
LOG_LEVEL=info


# -----------------------------------------------------------------------------------------------------
# 4. Contracts deployment (forge scripts in contracts/script). Export these in the shell, or put them in
#    contracts/.env, which Foundry auto-loads. The signer is NOT an env var: pass --account <keystore>,
#    --ledger / --trezor, or (discouraged) --private-key on the forge command line.
# -----------------------------------------------------------------------------------------------------

# foundry.toml [rpc_endpoints] robinhood = "${ROBINHOOD_RPC_URL}". REQUIRED whenever you use
# `--rpc-url robinhood` (otherwise: "environment variable `ROBINHOOD_RPC_URL` not found").
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# foundry.toml [etherscan] robinhood key = "${BLOCKSCOUT_API_KEY}" (Blockscout, chain 4663). Must be
# DEFINED when verifying (`--verify`) on chain 4663. It may be empty.
BLOCKSCOUT_API_KEY=

# Deploy.s.sol (all REQUIRED, read with vm.envUint / vm.envAddress). Preflight aborts before spending
# gas if any check fails.
# Chain id the RPC must report. 4663 = Robinhood Chain mainnet.
EXPECTED_CHAIN_ID=4663
# Canonical Uniswap V2 on Robinhood Chain, as in packages/shared/src/chains.ts and the Deploy.s.sol header.
# They must match ROBINHOOD_DEX in chains.ts, which is what the apps use. Preflight checks
# router.factory() == UNISWAP_V2_FACTORY on-chain.
UNISWAP_V2_FACTORY=0x8bceaa40b9acdfaedf85adf4ff01f5ad6517937f
UNISWAP_V2_ROUTER=0x89e5db8b5aa49aa85ac63f691524311aeb649eba
# $WIF on Robinhood Chain: the currency of every nation. Must equal WIF_ADDRESS in
# packages/shared/src/chains.ts. Preflight logs its symbol, decimals and supply; check them.
WIF_ADDRESS=0x5173b8eA6923c2d40267890D45C46a3480954773
# Receives protocol fees. IMMUTABLE after deployment. Must be non-zero, and a multisig (e.g. Safe) is
# recommended. Deliberately left empty, so forge fails until you set it.
PROTOCOL_FEE_RECIPIENT=
# $WIF (base units) a bonding curve raises before graduating to a nation/WIF Uniswap V2 pool. IMMUTABLE.
# Allowed range 1e6 to 1e36 base units. Recommended: 2 game market units = 2 x WIF_MARKET_UNIT
# (packages/shared/src/game/constants.ts, 100,000 WIF), i.e. 200000000000000000000000 (200,000 WIF at
# 18 decimals). Left empty so forge fails until you choose a value.
GRADUATION_WIF=
# $WIF (base units) burned every time a nation is founded. IMMUTABLE. 0 to GRADUATION_WIF. Example:
# 100000000000000000000 (100 WIF). Left empty so forge fails until you choose a value.
CREATION_FEE_WIF=
# DeployLocal.s.sol (anvil only, optional) reads its own LOCAL_* variables via vm.envOr instead of the
# two above, so production values in contracts/.env never leak into local deployments. Values set here
# affect dev-local, seed-local and the indexer integration test.
# Graduation threshold ($WIF base units) for local deployments. Default 200,000 WIF.
# LOCAL_GRADUATION_WIF=
# Creation fee ($WIF base units, burned) for local deployments. Default 100 WIF.
# LOCAL_CREATION_FEE_WIF=

# SmokeTest.s.sol (optional). Keep these commented out and pass them inline on the command line:
# SMOKE_CONFIRM must equal I_UNDERSTAND on any chain other than 31337 (the script spends real $WIF and gas).
# SMOKE_CONFIRM=I_UNDERSTAND
# Nation name: 2-32 chars [A-Za-z0-9 space - . ']. Unique forever on-chain. Default "Atlas Smoke Test".
# SMOKE_NAME=
# Ticker: 2-10 chars [A-Z0-9]. Unique forever on-chain. Default "SMOKE".
# SMOKE_SYMBOL=
# $WIF (base units) for the founder's initial buy. Default 100 WIF.
# SMOKE_INITIAL_BUY_WIF=
# $WIF (base units) for the second buy. Default 200 WIF.
# SMOKE_BUY_WIF=


# -----------------------------------------------------------------------------------------------------
# 5. Local development and tests (optional; never needed in production). Set them in the shell.
# -----------------------------------------------------------------------------------------------------

# scripts/dev-local.sh: Postgres URL it RESETS (drops schema public and drizzle).
# Default postgresql://atlas:atlas@localhost:5432/atlaspad
# DATABASE_URL=
# scripts/dev-local.sh: directory for anvil / indexer / web logs. Default /tmp/atlaspad-dev
# LOGS_DIR=
# apps/indexer/scripts/seed-local.ts: anvil RPC (must be chain 31337). Default http://127.0.0.1:8545
# LOCAL_RPC_URL=
# apps/indexer/test/integration.test.ts: set to exactly 1 to run the anvil + Postgres integration test.
# INTEGRATION=1
# Integration test database. It is DROPPED and recreated. Default
# postgresql://atlas:atlas@localhost:5432/atlaspad_test
# TEST_DATABASE_URL=
# Integration test: when the game-replay digests differ, it writes before.json / after.json here.
# DIGEST_DIR=
# apps/web/e2e/flows.e2e.mjs: Chromium executable for playwright-core.
# Default /opt/pw-browsers/chromium-1194/chrome-linux/chrome
# CHROMIUM_PATH=
